<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Статичная карта (заменяется при обновлении) -->
    <ImageView
        android:id="@+id/mapImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="#1a1a1a"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Карта"/>

    <!-- Кнопка "Открыть в картах" -->
    <TextView
        android:id="@+id/openMapBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 Открыть в картах"
        android:textSize="12sp"
        android:textColor="#ff5e8e"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Текст Live -->
    <TextView
        android:id="@+id/liveLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 LIVE"
        android:textSize="10sp"
        android:textColor="#ff3b30"
        android:paddingStart="8dp" paddingEnd="8dp" paddingTop="4dp" paddingBottom="4dp"
        android:visibility="gone"/>
</LinearLayout>
