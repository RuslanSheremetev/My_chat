<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Профиль -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp 20dp 20dp"
        android:background="@drawable/bg_settings_header">
        <TextView
            android:id="@+id/settingsAvatar"
            android:layout_width="90dp" android:layout_height="90dp"
            android:gravity="center"
            android:text="R" android:textColor="#fff"
            android:textSize="38sp" android:textStyle="bold"
            android:background="@drawable/bg_avatar_circle_blue"/>
        <TextView
            android:id="@+id/settingsName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Руслан" android:textColor="#fff"
            android:textSize="22sp" android:textStyle="bold"
            android:layout_marginTop="12dp"/>
        <TextView
            android:id="@+id/settingsUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@username" android:textColor="#777"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Карточка настроек -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="4dp 16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:id="@+id/settingsAccount" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsIconBg" android:background="@drawable/bg_icon_blue">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_profile"/>
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsTextBlock">
                        <TextView style="@style/SettingsLabel" android:text="Аккаунт"/>
                        <TextView style="@style/SettingsSub" android:text="Номер, имя пользователя, «О себе»"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/settingsChats" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsIconBg" android:background="@drawable/bg_icon_orange">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_chat"/>
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsTextBlock">
                        <TextView style="@style/SettingsLabel" android:text="Настройки чатов"/>
                        <TextView style="@style/SettingsSub" android:text="Обои, ночной режим, анимации"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/settingsPrivacy" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsIconBg" android:background="@drawable/bg_icon_green">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_privacy"/>
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsTextBlock">
                        <TextView style="@style/SettingsLabel" android:text="Конфиденциальность"/>
                        <TextView style="@style/SettingsSub" android:text="Время захода, устройства, ключи доступа"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/settingsNotifications" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsIconBg" android:background="@drawable/bg_icon_red">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_notifications"/>
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsTextBlock">
                        <TextView style="@style/SettingsLabel" android:text="Уведомления"/>
                        <TextView style="@style/SettingsSub" android:text="Звуки, звонки, счётчик сообщений"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/settingsData" style="@style/SettingsRow">
                    <LinearLayout style="@style/SettingsIconBg" android:background="@drawable/bg_icon_blue">
                        <ImageView style="@style/SettingsIcon" android:src="@drawable/ic_data"/>
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsTextBlock">
                        <TextView style="@style/SettingsLabel" android:text="Данные и память"/>
                        <TextView style="@style/SettingsSub" android:text="Настройки загрузки медиафайлов"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/settingsLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Выйти из аккаунта"
                android:textColor="#777"
                android:background="@drawable/bg_settings_card"
                android:padding="14dp"
                android:textSize="15sp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
