<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Фоновое свечение -->
    <View
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_atmosphere"
        android:alpha="0.3"/>

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feder"
        android:textSize="42sp"
        android:textColor="#ffd9e0"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Профиль"
        android:textSize="18sp"
        android:textColor="#d6c2c5"
        android:layout_marginTop="16dp"/>

    <!-- Аватарка -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp">
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:textSize="36sp"
            android:textColor="#e5e2e1"
            android:textStyle="bold"
            android:background="@drawable/avatar_circle"
            android:text="Р"/>
        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/online_dot"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Руслан Шереметев"
        android:textSize="20sp"
        android:textColor="#e5e2e1"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@ruslan"
        android:textSize="14sp"
        android:textColor="#d6c2c5"
        android:layout_marginTop="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дизайн в разработке"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginTop="8dp"/>

</LinearLayout>
</FrameLayout>
