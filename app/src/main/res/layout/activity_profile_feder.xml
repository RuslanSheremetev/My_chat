<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <!-- Фоновое свечение -->
    <View
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_atmosphere"
        android:alpha="0.3"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Верхняя панель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feder"
                android:textSize="24sp"
                android:textColor="#ffd9e0"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Аватарка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="40dp">
            
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:textSize="36sp"
                    android:textColor="#e5e2e1"
                    android:textStyle="bold"
                    android:background="@drawable/avatar_circle"
                    android:text="Р"/>
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/online_dot"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Руслан Шереметев"
                android:textSize="20sp"
                android:textColor="#e5e2e1"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@ruslan"
                android:textSize="14sp"
                android:textColor="#d6c2c5"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Статистика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_input"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:text="1,234" android:textSize="18sp" android:textColor="#ffd9e0" android:textStyle="bold"/>
                <TextView android:text="Сообщений" android:textSize="12sp" android:textColor="#d6c2c5" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:text="42" android:textSize="18sp" android:textColor="#81fc82" android:textStyle="bold"/>
                <TextView android:text="Чатов" android:textSize="12sp" android:textColor="#d6c2c5" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:text="5" android:textSize="18sp" android:textColor="#ffd9e0" android:textStyle="bold"/>
                <TextView android:text="Групп" android:textSize="12sp" android:textColor="#d6c2c5" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Меню -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="👤 Изменить профиль"
                android:textSize="16sp"
                android:textColor="#e5e2e1"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="🔒 Приватность"
                android:textSize="16sp"
                android:textColor="#e5e2e1"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="🌙 Тема"
                android:textSize="16sp"
                android:textColor="#e5e2e1"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="ℹ️ О приложении"
                android:textSize="16sp"
                android:textColor="#e5e2e1"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
