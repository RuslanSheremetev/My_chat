<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:orientation="vertical">

    <!-- Верхняя панель как в HTML -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="#1A1A1A">
        <TextView
            android:text="☰"
            android:textSize="20sp"
            android:textColor="#ffd9e0"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Feder"
            android:textSize="24sp"
            android:textColor="#ffd9e0"
            android:textStyle="bold"/>
        <TextView
            android:text="🔍"
            android:textSize="20sp"
            android:textColor="#ffd9e0"
            android:layout_marginEnd="12dp"/>
        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/avatar_circle"/>
    </LinearLayout>

    <!-- Контент профиля -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Аватарка -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:textSize="36sp"
                android:textColor="#e5e2e1"
                android:textStyle="bold"
                android:background="@drawable/avatar_circle"
                android:text="Р"/>
            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/online_dot"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Руслан Шереметев"
            android:textSize="20sp"
            android:textColor="#e5e2e1"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@ruslan"
            android:textSize="14sp"
            android:textColor="#d6c2c5"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>
