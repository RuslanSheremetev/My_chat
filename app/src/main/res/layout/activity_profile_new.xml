<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Шапка профиля -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#1a2a3a"
        android:paddingTop="40dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/profileAvatarLarge"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:gravity="center"
                android:textSize="38sp"
                android:textColor="#fff"
                android:textStyle="bold"
                android:background="@drawable/circle_avatar_bg"/>
            <View
                android:id="@+id/profileOnlineDot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/online_dot_green"/>
        </FrameLayout>

        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textColor="#fff"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:id="@+id/profileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#777777"/>
    </LinearLayout>

    <!-- Контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Информация -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИНФОРМАЦИЯ"
                android:textSize="12sp"
                android:textColor="#777777"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e1e1e"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:text="Статус" android:textColor="#fff" android:textSize="15sp" android:layout_weight="1"/>
                    <EditText
                        android:id="@+id/profileStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В сети"
                        android:textSize="14sp"
                        android:textColor="#777777"
                        android:background="@null"
                        android:gravity="end"
                        android:singleLine="true"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2c2c2c"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp">
                    <TextView android:text="О себе" android:textColor="#fff" android:textSize="15sp" android:layout_weight="1"/>
                    <EditText
                        android:id="@+id/profileBio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Расскажите о себе"
                        android:textSize="14sp"
                        android:textColor="#777777"
                        android:background="@null"
                        android:gravity="end"
                        android:singleLine="true"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2c2c2c"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp">
                    <TextView android:text="Телефон" android:textColor="#fff" android:textSize="15sp" android:layout_weight="1"/>
                    <TextView android:id="@+id/profilePhone" android:text="—" android:textSize="14sp" android:textColor="#777777"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Настройки -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЙКИ"
                android:textSize="12sp"
                android:textColor="#777777"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e1e1e"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp">
                    <TextView android:text="Тема" android:textColor="#fff" android:textSize="15sp" android:layout_weight="1"/>
                    <TextView android:text="Тёмная" android:textSize="14sp" android:textColor="#777777"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2c2c2c"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp">
                    <TextView android:text="Хранилище" android:textColor="#fff" android:textSize="15sp" android:layout_weight="1"/>
                    <Button
                        android:id="@+id/btnClearCache"
                        android:text="Очистить"
                        android:textSize="13sp"
                        android:textColor="#ff5e8e"
                        android:background="@drawable/btn_mini_bg"
                        android:paddingHorizontal="12dp"
                        android:layout_height="30dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Кнопки -->
            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Сохранить"
                android:textSize="15sp"
                android:textColor="#fff"
                android:background="@drawable/btn_pink_bg"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Выйти из аккаунта"
                android:textSize="15sp"
                android:textColor="#777777"
                android:background="#1e1e1e"
                android:layout_marginBottom="20dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
