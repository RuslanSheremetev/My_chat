<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Верхняя шапка -->
    <LinearLayout
        android:id="@+id/profileTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/profileBackBtn"
            android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md"
            android:src="@drawable/ic_arrow_back"
            android:tint="#b0b0b0"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageView
            android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md"
            android:src="@drawable/ic_more_vert"
            android:tint="#b0b0b0"/>
    </LinearLayout>

    <!-- Скролл -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/profileTopHeader"
        android:layout_above="@id/profileBottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="@dimen/spacing_xl">

            <!-- Аватарка с камерой -->
            <RelativeLayout
                android:layout_width="@dimen/avatar_size" android:layout_height="@dimen/avatar_size"
                android:layout_marginBottom="10dp">
                <TextView
                    android:id="@+id/profileAvatar"
                    android:layout_width="@dimen/avatar_size" android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="Р"
                    android:textColor="#fff" android:textSize="34sp"
                    android:textStyle="bold"/>
                <LinearLayout
                    android:layout_width="@dimen/avatar_badge" android:layout_height="@dimen/avatar_badge"
                    android:layout_alignBottom="@id/profileAvatar"
                    android:layout_alignEnd="@id/profileAvatar"
                    android:background="@drawable/bg_avatar_circle_small"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="14dp" android:layout_height="14dp"
                        android:src="@drawable/ic_camera"
                        android:tint="#b0b0b0"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- Имя -->
            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Руслан"
                android:textColor="#fff" android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Статистика -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12" android:textColor="#fff" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" Историй  " android:textColor="#777" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="34" android:textColor="#fff" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" Фото  " android:textColor="#777" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="8" android:textColor="#fff" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" Видео  " android:textColor="#777" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="6" android:textColor="#fff" android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" Аудио" android:textColor="#777" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Кнопки действий -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_action_pill"
                android:orientation="horizontal"
                android:padding="4dp">
                <LinearLayout android:id="@+id/actionCreate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@android:color/transparent">
                    <ImageView android:layout_width="@dimen/spacing_xl" android:layout_height="@dimen/spacing_xl" android:tint="#b0b0b0" android:src="@drawable/ic_gallery"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#b0b0b0" android:text="Создать"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/actionGallery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@android:color/transparent">
                    <ImageView android:layout_width="@dimen/spacing_xl" android:layout_height="@dimen/spacing_xl" android:tint="#b0b0b0" android:src="@drawable/ic_calendar"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#b0b0b0" android:text="Галерея"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/actionDrafts" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@android:color/transparent">
                    <ImageView android:layout_width="@dimen/spacing_xl" android:layout_height="@dimen/spacing_xl" android:tint="#b0b0b0" android:src="@drawable/ic_drafts"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#b0b0b0" android:text="Черновики"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Плавающая кнопка -->
            <LinearLayout
                android:id="@+id/fabAddMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:background="@drawable/bg_fab_pill"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_md" android:paddingBottom="@dimen/spacing_md" android:paddingStart="@dimen/icon_md" android:paddingEnd="@dimen/icon_md"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_add" android:tint="#fff"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Добавить медиа"
                    android:textColor="#fff" android:textSize="16sp"
                    android:textStyle="bold" android:layout_marginStart="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Нижнее меню -->
    <LinearLayout
        android:id="@+id/profileBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1c1c1e"
        android:paddingTop="@dimen/spacing_md" android:paddingStart="@dimen/spacing_xl" android:paddingEnd="@dimen/spacing_xl" android:paddingBottom="@dimen/spacing_xl"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/navChats2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:tint="#777777" android:src="@drawable/ic_home_simple"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#777777" android:text="Чаты"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:tint="#777777" android:src="@drawable/ic_settings_simple"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#777777" android:text="Настройки"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:src="@drawable/ic_profile" android:tint="#ff5e8e"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#ff5e8e" android:text="Профиль"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
