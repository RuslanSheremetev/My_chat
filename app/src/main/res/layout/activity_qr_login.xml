<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="60dp">

    <TextView
        android:layout_width="80dp" android:layout_height="80dp"
        android:gravity="center" android:text="M" android:textColor="#fff"
        android:textSize="36sp" android:textStyle="bold"
        android:background="@drawable/bg_logo_circle"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="MyChat" android:textColor="#fff"
        android:textSize="28sp" android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <FrameLayout
        android:layout_width="200dp" android:layout_height="200dp"
        android:background="@drawable/bg_qr_placeholder"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Вход по QR-коду" android:textColor="#fff"
        android:textSize="16sp" android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Сканировать QR-код" android:textColor="#fff"
        android:textSize="16sp" android:textStyle="bold"
        android:background="@drawable/bg_btn_pink"
        android:stateListAnimator="@null"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center"
        android:layout_marginTop="32dp" android:layout_marginBottom="24dp">
        <View android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1" android:background="#2c2c2c"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="или" android:textColor="#777" android:textSize="12sp"
            android:paddingHorizontal="12dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp"
            android:layout_weight="1" android:background="#2c2c2c"/>
    </LinearLayout>

    <TextView
        android:id="@+id/btnGoToLogin"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="вход по паролю" android:textColor="#777"
        android:textSize="13sp" android:clickable="true" android:focusable="true"/>

</LinearLayout>
