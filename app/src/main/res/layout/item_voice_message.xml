<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voicePlayer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp"
    android:paddingStart="12dp" android:paddingEnd="12dp"
    android:layout_marginTop="4dp">
    <TextView
        android:id="@+id/btnPlayVoice"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="▶"
        android:textSize="10sp"
        android:textColor="#fff"
        android:background="@drawable/circle_play_bg"/>
    <com.mychat.app.views.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="100dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:id="@+id/voiceDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#66ffffff"
        android:visibility="gone"/>
</LinearLayout>
